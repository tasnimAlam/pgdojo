# Maintainer: tasnimAlam
pkgname=pgdojo
pkgver=0.5.1
pkgrel=1
pkgdesc="PostgreSQL exercises in the terminal, in the spirit of pgexercises.com"
arch=('x86_64' 'aarch64')
url="https://github.com/tasnimAlam/pgdojo"
license=('MIT' 'CC-BY-SA-3.0')
depends=('glibc')
makedepends=('go')
optdepends=('podman: run the exercise database container'
            'podman-compose: run the exercise database container'
            'docker: run the exercise database container')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Run updpkgsums after tagging v$pkgver.
sha256sums=('SKIP')

build() {
  cd "pgdojo-$pkgver"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  go build -ldflags "-linkmode=external -X main.version=$pkgver" -o pgdojo ./cmd/pgdojo
}

check() {
  cd "pgdojo-$pkgver"
  # -short skips the integration tests that need a container runtime.
  go test -short ./...
}

package() {
  cd "pgdojo-$pkgver"
  install -Dm755 pgdojo "$pkgdir/usr/bin/pgdojo"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 internal/exercise/data/LICENSE-exercises "$pkgdir/usr/share/licenses/$pkgname/LICENSE-exercises"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 db/compose.yaml "$pkgdir/usr/share/$pkgname/db/compose.yaml"
  install -Dm644 db/roles.sql "$pkgdir/usr/share/$pkgname/db/roles.sql"

  ./pgdojo completion fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/pgdojo.fish"
  ./pgdojo completion bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/pgdojo"
  ./pgdojo completion zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_pgex"
}
